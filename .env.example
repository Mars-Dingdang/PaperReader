# Backend runtime
APP_ENV=dev
DATA_DIR=./data
SQLITE_DB_NAME=paperreader.db
CORS_ORIGINS=http://localhost:5173
AUTH_SECRET_KEY=change-this-in-real-use
SESSION_DAYS=1
REMEMBER_ME_DAYS=30

# OpenAI-compatible API
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# MinerU PDF parsing API (https://mineru.net/apiManage/docs)
MINERU_API_KEY=
MINERU_BASE_URL=https://mineru.net/api/v4
MINERU_MODEL_VERSION=vlm
MINERU_LANGUAGE=en
MINERU_ENABLE_FORMULA=true
MINERU_ENABLE_TABLE=true
MINERU_IS_OCR=false
MINERU_POLL_INTERVAL=5
MINERU_TIMEOUT=600

# LaTeX
LATEXMK_PATH=latexmk

# Queue
REDIS_URL=redis://localhost:6379/0

# Translation tuning
TRANSLATE_CONCURRENCY=4
TRANSLATE_MAX_RETRIES=5
# Global LLM request rate limit (requests per second). 0 disables limiting.
LLM_RATE_LIMIT_RPS=4
# Max characters joined per IR batch request.
TRANSLATE_BATCH_MAX_CHARS=6000

# Vision-model adversarial check (Phase D)
VISION_MODEL=GLM-4.5V
VISION_CHECK_ENABLED=true
VISION_CHECK_MODE=auto
VISION_CHECK_MAX_PAGES=8

# Frontend
VITE_BACKEND_URL=http://localhost:8000
